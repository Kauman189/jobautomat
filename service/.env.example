# jobautomat configuration template.
#
#   cp service/.env.example service/.env
#
# Parser rules (service/config.py): KEY=VALUE, no `export`, no spaces around
# the `=`, and surrounding quotes are stripped. List-type keys are written as
# valid JSON.
#
# Do NOT commit the real .env: it holds secrets.
# data/settings.json (SETTINGS_PATH) is applied ON TOP of this file.

# --- DeepSeek (LLM) ---------------------------------------------------------
# Required. https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-reemplaza-con-tu-clave
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Model for scoring, letters and the panel.
DEEPSEEK_MODEL=deepseek-flash
# Support model for long tasks (tailored CV, forms).
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# Model temperature (0.0-2.0; lower = more deterministic).
TEMPERATURA=0.4

# --- Telegram (notifications and approval) ---------------------------------
# Required unless TELEGRAM_HABILITADO=false. Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:reemplaza-con-tu-token
# Your chat with the bot (talk to it and press Start). Without it no notices arrive.
TELEGRAM_CHAT_ID=123456789
# true = send Telegram notices; false = run on webhook/panel only (no token needed).
TELEGRAM_HABILITADO=true
# Generic webhook (ntfy, Discord, Slack...). Empty = no webhook.
WEBHOOK_URL=

# --- Web panel --------------------------------------------------------------
# Fixed user: casa. Empty = panel without authentication (LAN only).
# In Docker, also define WEB_PASSWORD in the host environment or the root .env
# file: docker-compose.yml interpolates it and overrides the value here.
WEB_PASSWORD=cambia-esta-clave

# --- Search and scoring criteria -------------------------------------------
# Minimum score (0-100) to generate material and notify.
SCORE_THRESHOLD=80
# Band the scoring marks as "dubious" (must satisfy MIN <= MAX).
RANGO_DUDOSO_MIN=55
RANGO_DUDOSO_MAX=79
# Language of the descriptive scoring texts: en (default) or es.
# The 'recomendacion' value is never translated (aplicar/dudoso/descartar).
IDIOMA_SCORING=en

# --- Sources ----------------------------------------------------------------
# true/false (also 1/0, yes/no). LinkedIn is the main one; boards and JobSpy
# are complementary and optional.
FUENTES_LINKEDIN=true
FUENTES_BOARDS=true
FUENTES_JOBSPY=true

# --- Editable search (JSON lists) ------------------------------------------
# Extra topics to widen the queries.
TOPICS=["product design","design systems","ux research"]
# Target roles; they drive the title-based searches.
ROLES=["Product Designer","UX/UI Designer","Design Engineer"]
# Words that discard an offer (negative filter).
KEYWORDS_NEGATIVAS=["unpaid","no remunerado","comisión solo"]
# Preferred locations (empty = no extra geographic filter).
UBICACIONES=["Your Country","Europe","Remote"]
# remoto | hibrido | presencial
MODALIDAD=remoto
# Local time (HH:MM) of the daily run; in Docker CRON_HOUR/CRON_MINUTE win.
HORA_BUSQUEDA=02:00
# Active days (JSON list). Empty = every day.
DIAS_BUSQUEDA=[]

# --- Paths (local mount; in Docker the entrypoint manages them) ------------
DB_PATH=state.db
PERFIL_PATH=../data/perfil.json
# Overrides editable from the panel; wins over this .env.
SETTINGS_PATH=../data/settings.json
# Pipeline log (in Docker: /data/logs/jobautomat.log).
JOB_LOG_PATH=../data/logs/jobautomat.log

# --- LinkedIn session (patchright storage_state) ---------------------------
# Relative to service/ (or absolute). Generate it with:
#   python3 scripts/export_linkedin_session.py
SESSION_PATH=../data/linkedin_session.json
# 1 = headless (Docker); 0 = with a window (local development).
LINKEDIN_HEADLESS=1
# Timezone the browser declares when opening LinkedIn.
LINKEDIN_TIMEZONE=Europe/London
# Warn when the LinkedIn session (cookies) is about to expire.
ALERTAR_SESION_LINKEDIN=true
# Days before expiry that trigger the warning (1-365).
SESION_LINKEDIN_MAX_DIAS=14

# --- Pipeline ---------------------------------------------------------------
# Maximum age (days) of the offers that get scored.
MAX_ANTIGUEDAD_DIAS=30
# Local runs only; in Docker docker-compose.yml sets it.
# CANDIDATURAS_DIR=../candidaturas
# Local read only; in Docker docker-compose.yml sets it.
# WEB_PORT=8085
